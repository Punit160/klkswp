# Rename this file to .env and fill in real values. Never commit .env.

# KLK Ventures monitoring service license key — kept server-side only, never sent to the browser.
TELEMETRY_WSC_KEY=your-license-key-here

# Base URL of the monitoring service API
TELEMETRY_API_BASE=https://ssp.ektvam.net/api/ws

# Random long string used to sign session cookies. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Port the portal listens on
PORT=3002

# Set to "true" once you're serving over HTTPS in production, so cookies are sent Secure-only.
COOKIE_SECURE=false
